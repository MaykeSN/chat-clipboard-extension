{
  "manifest_version": 3,
  "name": "Chat Clipboard",
  "version": "1.0.0",
  "description": "Copia o historico de mensagens do chat de atendimento (PureCloud + invenit.cloud) para o clipboard, ja formatado com data, papel e texto limpo.",
  "author": "Mayke de Souza Nogueira",
  "homepage_url": "https://github.com/MaykeSN/chat-clipboard-extension",

  "permissions": [
    "clipboardWrite",
    "scripting",
    "activeTab",
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "content_script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "commands": {
    "copy-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Extrai e copia o chat atual para o clipboard"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Chat Clipboard - configuracoes e copia",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
